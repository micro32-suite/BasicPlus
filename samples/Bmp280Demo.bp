// ============================================================
// Bmp280Demo.bp — demo en placa del sensor BMP280 (o BME280)
// por I2C: temperatura + presión, en bucle.
//
// El bus, el del periférico. Por software (V9 H3) se cambia el constructor, y su import:
// lo demás es igual. Bucle infinito a propósito (probar Stop).
// ============================================================
module Bmp280Demo
  import I2c
  // import SoftI2c
  import Bmp280

  function Main()
    var bus: I2c.I2C := I2c.HardI2C(0, 20, 21, 100000)     // SDA=GP20, SCL=GP21
    // var bus: I2c.I2C := SoftI2c.SoftI2C(20, 21)         // por software, en los mismos pines

    print "Escaneando bus I2C..."
    var devs: integer[] := bus.scan()
    var i: integer := 0
    while i < len(devs) do
      print "  dispositivo I2C (dec) = ", devs[i]
      i := i + 1
    endwh

    var s: Bmp280.Sensor := Bmp280.Sensor(bus, 0x76)
    if s.begin() then
      print "BMP280/BME280 OK: chip (dec)=", s.chipID()
      while true do
        s.measure()
        print "T=", s.temperature(), "C   P=", s.pressure(), "hPa"
        sleep(2000)
      endwh
    else
      print "no encontrado en 0x76 (chip dec=", s.chipID(), "). Prueba 0x77."
    endif
  end Main

end Bmp280Demo
