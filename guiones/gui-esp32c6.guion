// La interfaz gráfica, en la Waveshare ESP32-C6-LCD-1.3
placa_comprobar micro=esp32c6

// La zona de packs, desde cero: lo pregunta antes (con un no, no se ha tocado nada)
packs_formatear

// El panel y la memoria de los motores: se leen al arrancar
entorno_poner rw clave=spi2 valor=sck:7,mosi:6,miso:5
entorno_poner rw clave=lcd valor=st7789,spi:2,dc:15,cs:14,rst:21,bl:22,mhz:40,w:240,h:240,ram:240x320,inv
entorno_poner rw clave=packRam valor=136
placa_reiniciar reconectar

// Los packs. La biblioteca, la primera: sin ella en la flash, la GUI no cabe en la RAM
pack_grabar pack=Stdlib
pack_grabar pack=GuiMini
pack_grabar pack=DriverSpi
