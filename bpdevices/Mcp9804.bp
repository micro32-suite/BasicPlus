// ============================================================
// Mcp9804.bp — driver para el sensor de temperatura I²C MCP9804.
//
// Port directo del driver Python equivalente. El MCP9804 es un
// termómetro digital de ±0.5°C, resolución 0.0625°C, rango
// -40..+125°C. Direcciones I²C 0x18..0x1F según pines A0/A1/A2.
//
// Registro 0x05 = Ambient Temperature (16 bits):
//   MSB: [TA/TUP/TLO flags : 3 bits][SIGN : 1][T11..T8 : 4 bits]
//   LSB: [T7..T0 : 8 bits]
//
// La resolución 1/16 LSB significa que el valor de 12 bits
// dividido entre 16 da los grados. El signo, en complemento a 2:
// por debajo de cero, ese valor menos 256 grados.
//
// Uso, con un bus del periférico o por software (V9 H3):
//   import I2c
//   import Mcp9804
//   var bus: I2c.I2C := I2c.HardI2C(1, 2, 3, 100000)   // o modSoftI2C.SoftI2C(2, 3)
//   var s: Mcp9804.Sensor := Mcp9804.Sensor(bus, 0x18)
//   var t: float := s.readTemp()
//   print "T =", t
// O con el número de un bus del periférico ya abierto (I2c.init): Mcp9804.Sensor(1, 0x18).
// ============================================================
module Mcp9804
  import I2c

  public class Sensor
    var bus:   I2c.I2C
    var busId: integer
    var addr:  integer

    public function Sensor(bus: I2c.I2C, addr: integer)
      this.bus  := bus
      this.addr := addr
    end Sensor

    public function Sensor(busId: integer, addr: integer)
      this.busId := busId
      this.addr  := addr
    end Sensor

    // El bus con el que se construyó; o, con el número de uno del periférico, ése —ya abierto,
    // o declarado en el ENV de la placa—, que se toma la primera vez que hace falta.
    function bus_(): I2c.I2C
      if this.bus == null then this.bus := I2c.HardI2C(this.busId, -1, -1, 0)
      return this.bus
    end bus_

    // Lee la temperatura en grados Celsius.
    public function readTemp(): float
      // Los 2 bytes del registro 0x05 (Ambient Temperature): [MSB, LSB].
      var data: integer[] := [0, 0]
      this.bus_().readRegs(this.addr, 0x05, data, 2)
      var msb: integer := data[0]
      var lsb: integer := data[1]
      // Limpia los bits de flag (mantenemos bits 4..0).
      msb := msb & 0x1F
      var temp: float := 0.0
      if (msb & 0x10) == 0x10 then
        // Por debajo de cero: sin el bit de signo, y menos 256. (V9 #911: el ejemplo de su hoja de datos lo da al revés,
        // 256 menos lo leído, y -10 grados salían 10.)
        msb := msb & 0x0F
        temp := msb * 16.0 + lsb / 16.0 - 256.0
      else
        // Temperatura positiva.
        temp := msb * 16.0 + lsb / 16.0
      endif
      return temp
    end readTemp

  end Sensor

end Mcp9804
