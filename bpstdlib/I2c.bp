// ============================================================
// I2c.bp — control de bus I2C en dispositivos embebidos.
//
// Plataformas:
//   - RP2350 (Pico 2): 2 buses HW (i2c0, i2c1).
//   - PC (Java/host C): logging por stdout — desarrollo sin HW.
//
// Buffers de bytes: parámetros `integer[]` donde cada slot
// transporta un byte (solo el byte bajo, 0..255). El frontend
// los serializa correctamente en .bpi cross-module gracias a
// L-arr-export.
//
// EL BUS SE COMPARTE (V7/H6.c G4.a1): la configuración de un bus —sus pines y su
// velocidad, que la tienen que aguantar todos— se establece UNA vez: la declara la
// placa en el ENV (`i2c0=sda:0,scl:1,khz:400`)
// o, si no, el primero que lo abre. Después, abrirlo con los MISMOS pines (o con
// -1: «los que tenga») se engancha, y con OTROS es un error con nombre:
//   «el I2C 0 es sda 0, scl 1 a 400 kHz (ENV i2c0): pides 100 kHz».
// Sus pines quedan reservados: un Gpio.Pin sobre ellos dice «el pin N es del I2C 0».
// release() lo suelta —salvo el de la placa o si lo usa otro—, y el fin del programa
// también.
//
// Hay DOS formas de usar este módulo:
//
//   A) Las clases (V9 H3.1; lo normal, ver HW_CLASS_POLICY):
//
//        import I2c
//        var bus: I2c.I2C := I2c.HardI2C(0, 6, 7, I2c.FAST())
//        bus.write(0x48, [0x00], 1)
//
//      I2C es la base: un bus, sea el del periférico (HardI2C) o uno por software
//      (SoftI2c.SoftI2C, en su módulo: en dos pines cualesquiera, para cuando no quedan buses
//      o los pines no coinciden). Es lo que pide la librería de un dispositivo, que no sabe
//      cuál es: se cambia de uno a otro cambiando el constructor, y lo demás es igual. Bus es
//      HardI2C con el nombre de siempre: lo ya escrito no cambia.
//
//   B) Funciones top-level, con el número del bus (la forma original, para los drivers ya
//      escritos):
//
//        import I2c
//        I2c.init(0, 6, 7, I2c.FAST())
//        I2c.write(0, 0x48, [0x00], 1)
//
// Las dos formas comparten el mismo backend nativo.
//
// ESCRIBIR Y LEER EN UNA TRANSACCIÓN (V7/H6.c G4.a3). Leer un registro son dos
// mensajes —su número y la lectura— con un REPEATED START entre ellos: nadie más
// habla en medio (en la C5, el táctil comparte el I2C 0 con el expansor, y la
// pantalla también lo lee):
//
//        var r: integer[] := newIntArray(6)
//        bus.writeRead(0x76, [0xF7], 1, r, 6)
//
// Varios mensajes seguidos, en una I2c.Transaction —se PREPARA y se ejecuta de UNA
// vez; repeated start entre mensajes y STOP al final—:
//
//        var t: I2c.Transaction := I2c.Transaction()
//        t.write([0xF4, 0x27], 2)
//        t.write([0xF5, 0xA0], 2)
//        bus.execute(0x76, t)
//
// Lo que cabe en una transacción, igual en todos los micros (lo que puede el ESP32: 8
// órdenes del bus): hasta 3 mensajes de al menos un byte —cada mensaje son 2 órdenes,
// una lectura de más de un byte 3, y el STOP 1— y 256 bytes. El bus no se monopoliza: antes de
// empezar se calcula cuánto lo ocupará (9 relojes por byte, la dirección de cada
// mensaje incluida) y si pasa del tope del bus —20 ms, o el `ms:` de su línea del
// ENV— es un error con nombre y no se transfiere nada. Un dispositivo que no
// contesta devuelve -1, como en read/write.
// ============================================================
module I2c

  // ---- Intrínsecos de bajo nivel ----
  //
  // Sufijo "Bus" para evitar colisión con los métodos init/write/
  // read de la clase Bus envolvente (dentro de un método de la
  // clase, `write(...)` resolvería a sí mismo → recursión).
  public function initBus(bus: integer, sda: integer, scl: integer, baudrate: integer)
    inline CALL_BUILTIN 82
  end initBus
  public function writeBus(bus: integer, addr: integer, data: integer[], count: integer): integer
    inline CALL_BUILTIN 83
  end writeBus
  public function readBus(bus: integer, addr: integer, data: integer[], count: integer): integer
    inline CALL_BUILTIN 84
  end readBus
  // V7/H6.c G4.a1 — el programa suelta el bus (ver la cabecera).
  public function releaseBus(bus: integer)
    inline CALL_BUILTIN 257
  end releaseBus
  // V7/H6.c G4.a3 — escribir y leer, y una transacción (ver la cabecera).
  public function writeReadBus(bus: integer, addr: integer, tx: integer[], ntx: integer, rx: integer[], nrx: integer): integer
    inline CALL_BUILTIN 261
  end writeReadBus
  public function executeBus(bus: integer, addr: integer, ops: integer[], nops: integer, tx: integer[], rx: integer[]): integer
    inline CALL_BUILTIN 262
  end executeBus

  // ---- Funciones top-level de compatibilidad ----
  //
  // Conservan los nombres cortos init/write/read del API original.
  // Internamente delegan en los intrínsecos *Bus. Coste: 1 frame
  // extra de stack por llamada. Despreciable salvo en loops muy
  // tight donde merezca la pena usar la clase directamente.

  public function init(bus: integer, sda: integer, scl: integer, baudrate: integer)
    initBus(bus, sda, scl, baudrate)
  end init

  public function write(bus: integer, addr: integer, data: integer[], count: integer): integer
    return writeBus(bus, addr, data, count)
  end write

  public function read(bus: integer, addr: integer, data: integer[], count: integer): integer
    return readBus(bus, addr, data, count)
  end read

  public function release(bus: integer)
    releaseBus(bus)
  end release

  // Escribe `ntx` bytes y lee `nrx` en UNA transacción, con repeated start entre las
  // dos (V7/H6.c G4.a3). Devuelve los bytes leídos, o -1 si el dispositivo no contesta.
  public function writeRead(bus: integer, addr: integer, tx: integer[], ntx: integer, rx: integer[], nrx: integer): integer
    return writeReadBus(bus, addr, tx, ntx, rx, nrx)
  end writeRead

  // Escanea el bus completo (direcciones I2C válidas 0x08..0x77) y
  // devuelve un array con las direcciones de los dispositivos que
  // respondieron al ACK. Implementado puramente en BP llamando a
  // readBus(1 byte) — no necesita opcode dedicado.
  public function scan(bus: integer): integer[]
    var rxbuf: integer[] := [0]
    var max: integer[] := newIntArray(112)        // pre-alloc 112 slots
    var found: integer := 0
    var addr: integer := 0x08
    while addr < 0x78 do
      var rc: integer := readBus(bus, addr, rxbuf, 1)
      if rc >= 0 then
        max[found] := addr
        found := found + 1
      endif
      addr := addr + 1
    endwh
    // Devuelve copia recortada al tamaño exacto.
    var result: integer[] := newIntArray(found)
    move(max, result, 0, 0, found)
    return result
  end scan

  // -------- Constantes de conveniencia --------
  public function BUS0(): integer
    return 0
  end BUS0
  public function BUS1(): integer
    return 1
  end BUS1
  public function STANDARD(): integer
    return 100000
  end STANDARD
  public function FAST(): integer
    return 400000
  end FAST

  // Lo que se mira de un array antes de usarlo, con los textos del C (#534). `max` 0 = sin tope.
  public function __checkArray(data: integer[], count: integer, op: string, which: string, max: integer)
    if data == null then
      throw RuntimeError(op + ": " + which + " es null")
    endif
    if count < 0 then
      throw RuntimeError(op + ": count negativo (" + intToString(count) + ")")
    endif
    if count > len(data) then
      throw RuntimeError(op + ": count (" + intToString(count) + ") mayor que " + which + " (" + intToString(len(data)) + ")")
    endif
    if max > 0 and count > max then
      throw RuntimeError(op + ": count (" + intToString(count) + ") supera el máximo de " + intToString(max) + " bytes por transacción")
    endif
  end __checkArray

  // Un mensaje de una transacción (interno).
  class Op
    public property kind:   integer     // 1 escribir · 2 leer
    public property count:  integer
    public property data:   integer[]
    public property nextOp: Op
    public function Op(kind: integer, count: integer, data: integer[])
      this.kind  := kind
      this.count := count
      this.data  := data
    end Op
  end Op

  // ============================================================
  // Clase Transaction — V7/H6.c G4.a3: varios mensajes seguidos, sin nadie en medio.
  //
  // Se PREPARA —write/read se van añadiendo, y aquí no se toca el bus— y se ejecuta de
  // una vez con bus.execute(addr, t): START, cada mensaje con un repeated start entre
  // dos, STOP al final. Se puede reutilizar: cada ejecución manda lo que tengan EN ESE
  // MOMENTO los arrays de escritura y rellena los de lectura. clear() la vacía.
  // ============================================================
  public class Transaction

    var first: Op
    var last:  Op
    var n:     integer
    var ops:   integer[]     // (tipo, bytes) por mensaje: lo que recibe el builtin
    var txAll: integer[]     // lo que se escribe, seguido
    var rxAll: integer[]     // lo que se lee, seguido

    public function Transaction()
      this.n := 0
    end Transaction


    // Añade un mensaje: escribir `count` bytes de `data`.
    public function write(data: integer[], count: integer)
      __checkArray(data, count, "I2c.Transaction.write", "el array", 0)
      this.add(Op(1, count, data))
    end write

    // Añade un mensaje: leer `count` bytes en `data`.
    public function read(data: integer[], count: integer)
      __checkArray(data, count, "I2c.Transaction.read", "el array", 0)
      this.add(Op(2, count, data))
    end read

    // Cuántos mensajes lleva.
    public function size(): integer
      return this.n
    end size

    // La vacía, para prepararla otra vez.
    public function clear()
      this.first := null
      this.last  := null
      this.n     := 0
    end clear

    // Ejecuta la transacción con el dispositivo `addr` del bus del periférico `bus` (por su
    // número); con un I2C, bus.execute(addr, t).
    public function executeOn(bus: integer, addr: integer): integer
      this.__gather()
      var r: integer := executeBus(bus, addr, this.ops, this.n, this.txAll, this.rxAll)
      if r >= 0 then this.__scatter()
      return r
    end executeOn

    // ---- para quien la ejecuta (I2C, más abajo): lo que se escribe, reunido —lo que tienen los
    // arrays AHORA—; lo leído, a su sitio; y los tres arrays.
    public function __gather()
      var sale:  integer := 0
      var entra: integer := 0
      var o: Op := this.first
      while o != null do
        if o.kind == 1 then
          sale := sale + o.count
        else
          entra := entra + o.count
        endif
        o := o.nextOp
      endwh
      if this.txAll == null then
        this.txAll := newIntArray(sale)
      elseif len(this.txAll) < sale then
        this.txAll := newIntArray(sale)
      endif
      if this.rxAll == null then
        this.rxAll := newIntArray(entra)
      elseif len(this.rxAll) < entra then
        this.rxAll := newIntArray(entra)
      endif
      if this.ops == null then
        this.ops := newIntArray(0)
      endif
      var p: integer := 0
      o := this.first
      while o != null do
        if o.kind == 1 then
          move(o.data, this.txAll, 0, p, o.count)
          p := p + o.count
        endif
        o := o.nextOp
      endwh
    end __gather

    public function __scatter()
      var p: integer := 0
      var o: Op := this.first
      while o != null do
        if o.kind == 2 then
          move(this.rxAll, o.data, p, 0, o.count)
          p := p + o.count
        endif
        o := o.nextOp
      endwh
    end __scatter

    public function __ops(): integer[]
      return this.ops
    end __ops
    public function __tx(): integer[]
      return this.txAll
    end __tx
    public function __rx(): integer[]
      return this.rxAll
    end __rx

    function add(o: Op)
      if this.first == null then
        this.first := o
      else
        this.last.nextOp := o
      endif
      this.last := o
      // (tipo, bytes) al array de mensajes, que crece de dos en dos
      if this.ops == null then
        this.ops := newIntArray(8)
      elseif len(this.ops) < 2 * this.n + 2 then
        var mas: integer[] := newIntArray(2 * len(this.ops))
        move(this.ops, mas, 0, 0, 2 * this.n)
        this.ops := mas
      endif
      this.ops[2 * this.n] := o.kind
      this.ops[2 * this.n + 1] := o.count
      this.n := this.n + 1
    end add

  end Transaction

  // n en hexadecimal, con al menos `min` cifras: así dicen los textos de I2C una dirección.
  public function __hex(n: integer, min: integer): string
    var d: string := "0123456789ABCDEF"
    var s: string := ""
    var i: integer := 28
    while i >= 0 do
      var c: integer := (n shr i) & 15
      if c != 0 or s != "" or i < 4 * min then s := s + charAt(d, c)
      i := i - 4
    endwh
    return s
  end __hex

  // ============================================================
  // Clase I2C — un bus I2C: la base de HardI2C (el periférico) y de SoftI2c.SoftI2C (por
  // software). Como si fuera abstracta: los métodos que tocan el cable los pone cada bus, y
  // los demás se hacen con ellos, una vez. Una clase propia también puede ser un I2C (un
  // multiplexor, un sensor simulado para una prueba): hereda de ésta y pone los suyos.
  //
  // Uso típico:
  //
  //   import I2c
  //   var bus: I2c.I2C := I2c.HardI2C(0, 6, 7, I2c.FAST())
  //   var devs: integer[] := bus.scan()
  //   for d in devs do
  //     print "device at 0x", d
  //   next d
  //   bus.writeReg(0x76, 0xF4, 0x27)
  //   var temp: integer[] := newIntArray(3)
  //   if bus.readRegs(0x76, 0xFA, temp, 3) < 0 then print "no contesta"
  // ============================================================
  public class I2C

    // Static consts para uso sin instanciar: I2c.I2C.STANDARD
    public const I2C.STANDARD: integer := 100000
    public const I2C.FAST:     integer := 400000

    var closed_: boolean       // ya se soltó con release()

    // ---- lo que pone cada bus

    // Escribe `count` bytes al dispositivo `addr`. Devuelve los bytes escritos, o -1 si no
    // contesta.
    public function write(addr: integer, data: integer[], count: integer): integer
      throw RuntimeError("I2C.write: lo pone cada bus")
    end write

    // Lee `count` bytes del dispositivo `addr` en `data`. Devuelve los bytes leídos, o -1 si
    // no contesta.
    public function read(addr: integer, data: integer[], count: integer): integer
      throw RuntimeError("I2C.read: lo pone cada bus")
    end read

    // Suelta el bus (V7/H6.c G4.a1): si nadie más lo usa y no es de la placa, se cierra y
    // sus pines vuelven a libres. Soltarlo otra vez no hace nada; usarlo después es un error
    // con nombre, como con un Gpio.Pin (V7 #667).
    public function release()
      if not this.closed_ then
        this.closed_ := true
        this.close_()
      endif
    end release

    // Escribe `ntx` bytes y lee `nrx` en UNA transacción, con repeated start entre las
    // dos: el registro de un sensor sin nadie en medio (V7/H6.c G4.a3). Devuelve los
    // bytes leídos, o -1 si el dispositivo no contesta.
    public function writeRead(addr: integer, tx: integer[], ntx: integer, rx: integer[], nrx: integer): integer
      throw RuntimeError("I2C.writeRead: lo pone cada bus")
    end writeRead

    // ---- lo que se hace con ellos, igual en todos

    // Ejecuta una I2c.Transaction con el dispositivo `addr`: todos sus mensajes en UNA
    // transacción. Devuelve los bytes movidos, o -1 si el dispositivo no contesta.
    public function execute(addr: integer, t: Transaction): integer
      this.check_(addr)
      t.__gather()
      var r: integer := this.run_(addr, t.__ops(), t.size(), t.__tx(), t.__rx())
      if r >= 0 then t.__scatter()
      return r
    end execute

    // Escanea el bus completo (0x08..0x77) y devuelve un array con las direcciones que
    // respondieron.
    public function scan(): integer[]
      var rxbuf: integer[] := [0]
      var max:   integer[] := newIntArray(112)
      var found: integer := 0
      var addr:  integer := 0x08
      while addr < 0x78 do
        if this.read(addr, rxbuf, 1) >= 0 then
          max[found] := addr
          found := found + 1
        endif
        addr := addr + 1
      endwh
      var result: integer[] := newIntArray(found)
      move(max, result, 0, 0, found)
      return result
    end scan

    // ¿Contesta alguien en `addr`?
    public function isPresent(addr: integer): boolean
      var rxbuf: integer[] := [0]
      return this.read(addr, rxbuf, 1) >= 0
    end isPresent

    // Los REGISTROS de un dispositivo: casi todos los sensores son eso, un número de registro
    // y sus bytes. Escribe uno; devuelve -1 si no contesta.
    public function writeReg(addr: integer, reg: integer, value: integer): integer
      return this.write(addr, [reg, value], 2)
    end writeReg

    // Lee `count` bytes desde el registro `reg`, en UNA transacción. Devuelve los bytes
    // leídos, o -1 si no contesta.
    public function readRegs(addr: integer, reg: integer, data: integer[], count: integer): integer
      return this.writeRead(addr, [reg], 1, data, count)
    end readRegs

    // El valor de un registro (0..255), o -1 si no contesta.
    public function readReg(addr: integer, reg: integer): integer
      var b: integer[] := [0]
      if this.writeRead(addr, [reg], 1, b, 1) < 0 then return -1
      return b[0] & 0xFF
    end readReg

    // ---- para los buses (internos): cómo se llama en los textos; soltarlo de verdad; los
    // mensajes de una transacción —(1 escribir · 2 leer, bytes) por mensaje, en `ops`; lo que
    // se escribe y lo que se lee, seguido—; y lo que se mira antes de cada operación.
    function name_(): string
      return "I2C"
    end name_

    function close_()
    end close_

    function run_(addr: integer, ops: integer[], nops: integer, tx: integer[], rx: integer[]): integer
      throw RuntimeError("I2C.execute: lo pone cada bus")
    end run_

    function check_(addr: integer)
      if this.closed_ then throw RuntimeError(this.name_() + ": ya se soltó con release()")
      if addr < 0 or addr > 0x7F then throw RuntimeError(this.name_() + ": dirección no válida (0x" + __hex(addr, 1) + ")")
    end check_

  end I2C

  // ============================================================
  // Clase HardI2C — el bus de un periférico I2C del micro, con sus pines SDA/SCL y su
  // velocidad. La gracia es que no arrastras el número de bus en cada operación.
  // ============================================================
  public class HardI2C extends I2C

    public property id:       integer    // el número del periférico: 0 (i2c0), 1 (i2c1)…
    public property sda:      integer
    public property scl:      integer
    public property baudrate: integer

    // Constructor: abre el bus (ver la cabecera: -1 en los pines, «los que tenga»).
    public function HardI2C(id: integer, sda: integer, scl: integer, baudrate: integer)
      this.id       := id
      this.sda      := sda
      this.scl      := scl
      this.baudrate := baudrate
      initBus(id, sda, scl, baudrate)
    end HardI2C

    public function write(addr: integer, data: integer[], count: integer): integer
      this.check_(addr)
      return writeBus(this.id, addr, data, count)
    end write

    public function read(addr: integer, data: integer[], count: integer): integer
      this.check_(addr)
      return readBus(this.id, addr, data, count)
    end read

    public function writeRead(addr: integer, tx: integer[], ntx: integer, rx: integer[], nrx: integer): integer
      this.check_(addr)
      return writeReadBus(this.id, addr, tx, ntx, rx, nrx)
    end writeRead

    function run_(addr: integer, ops: integer[], nops: integer, tx: integer[], rx: integer[]): integer
      return executeBus(this.id, addr, ops, nops, tx, rx)
    end run_

    // Sin destructor A PROPÓSITO (ver Spi.Bus.release): dos HardI2C con el mismo número son
    // el MISMO bus.
    function close_()
      releaseBus(this.id)
    end close_

    function name_(): string
      return "I2C " + intToString(this.id)
    end name_

  end HardI2C

  // Bus — HardI2C, con el nombre de siempre: lo escrito hasta V8 no cambia.
  public class Bus extends HardI2C

    public const Bus.STANDARD: integer := 100000
    public const Bus.FAST:     integer := 400000

    public function Bus(id: integer, sda: integer, scl: integer, baudrate: integer)
      super(id, sda, scl, baudrate)
    end Bus

  end Bus

end I2c
